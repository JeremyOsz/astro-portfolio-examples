---
import "@/styles/starwind.css";
import "../styles/global.css";
import { PALETTE_STORAGE_KEY } from "../lib/palettes";
import { MAIN_NAV } from "../lib/mainNav";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description, currentPath = "/" } = Astro.props;

const navItems = MAIN_NAV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script define:vars={{ PALETTE_STORAGE_KEY }}>
      try {
        const id = localStorage.getItem(PALETTE_STORAGE_KEY);
        if (id) document.documentElement.setAttribute("data-palette", id);
      } catch (_) {}
    </script>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased archive-texture">
    <div class="mx-auto max-w-[1320px] px-5 py-5 md:px-8 md:py-8">
      <header class="mb-10 border-b border-line pb-4 lg:hidden">
        <div class="flex items-baseline justify-between gap-5">
          <a href="/" class="text-[13px] uppercase tracking-[0.16em] hover:opacity-60 transition-opacity">
            Portfolio Studies
          </a>
          <a href="/palette" class="text-[12px] text-muted hover:text-ink transition-colors">Palette</a>
        </div>
        <nav class="mt-4 flex flex-wrap gap-x-4 gap-y-2" aria-label="Main navigation">
          {navItems.map((item) => {
            const isCurrent = currentPath === item.href ||
              (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`text-[12px] uppercase tracking-[0.12em] ${
                  isCurrent ? "text-ink" : "text-muted"
                }`}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            );
          })}
        </nav>
      </header>
      <div class="grid gap-10 lg:grid-cols-[240px_minmax(0,1fr)] lg:gap-14">
        <aside class="hidden lg:block lg:sticky lg:top-8 lg:h-[calc(100vh-4rem)]">
          <div class="flex h-full flex-col">
            <a href="/" class="text-[12px] uppercase tracking-[0.2em] text-muted transition-opacity hover:opacity-60">
              Portfolio Studies
            </a>
            <p class="mt-3 max-w-[16ch] font-serif text-[26px] leading-[1.05]">
              Artist pages as an editorial archive.
            </p>
            <nav class="mt-12 space-y-2" aria-label="Main navigation">
              {navItems.map((item) => {
                const isCurrent = currentPath === item.href ||
                  (item.href !== "/" && currentPath.startsWith(item.href));
                return (
                  <a
                    href={item.href}
                    class={`group flex items-baseline gap-3 py-1 transition-opacity ${
                      isCurrent ? "text-ink" : "text-muted hover:text-ink"
                    }`}
                    aria-current={isCurrent ? "page" : undefined}
                  >
                    <span class="w-7 text-[11px] tabular-nums">{item.id}</span>
                    <span class="text-[14px]">{item.label}</span>
                  </a>
                );
              })}
            </nav>
            <div class="mt-auto border-t border-line pt-4">
              <p class="text-[11px] uppercase tracking-[0.12em] text-muted">2026 Edition</p>
              <a href="/palette" class="mt-1 inline-block text-[12px] text-muted hover:text-ink transition-colors">
                Palette switch
              </a>
            </div>
          </div>
        </aside>
        <div class="min-w-0">
          <slot />
          <footer class="mt-20 border-t border-line pt-5 pb-8">
            <div class="flex items-baseline justify-between gap-4">
              <p class="text-[11px] uppercase tracking-[0.12em] text-muted">Portfolio Studies</p>
              <p class="text-[12px] text-muted">Built with Astro</p>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </body>
</html>
