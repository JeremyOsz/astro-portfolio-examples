---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { pickImages } from "../../lib/imagePool";

export async function getStaticPaths() {
  const posts = await getCollection("blog", (e) => !e.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

function formatBlogDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const { slug } = Astro.params;
const entry = slug ? await getEntry("blog", slug) : null;
const featuredImage = slug ? pickImages(`blog-featured-${slug}`, 1, "landscape")[0] : null;
const { Content } = entry ? await render(entry) : { Content: null };
---

{entry && Content ? (
  <BaseLayout
    title={`${entry.data.title} — Blog`}
    description={entry.data.excerpt}
    currentPath="/blog"
  >
    <main>
      <a href="/blog" class="inline-block text-[12px] text-muted hover:text-ink transition-opacity mb-8">
        ← Blog
      </a>

      <header class="border-b border-line pb-8 md:pb-10">
        <p class="section-kicker">{entry.data.category}</p>
        <h1 class="display-title mt-3 max-w-[12ch] relative">
          {entry.data.title}
          <span class="ghost-index top-0 right-auto" style="left:70%" aria-hidden="true">05</span>
        </h1>
        <p class="mt-3 text-[13px] text-muted">{formatBlogDate(entry.data.date)}</p>
      </header>

      {featuredImage && (
        <figure class="my-10 md:my-12">
          <div class="aspect-[16/10]">
            <img
              src={featuredImage.src}
              alt={featuredImage.alt}
              loading="eager"
              class="h-full w-full object-cover"
            />
          </div>
        </figure>
      )}

      <div class="blog-body max-w-[60ch]">
        <Content />
      </div>
    </main>
  </BaseLayout>
) : (
  <BaseLayout title="Not found" currentPath="/blog">
    <main>
      <p class="text-muted">Post not found.</p>
      <a href="/blog" class="inline-block mt-4 text-ink underline">← Back to blog</a>
    </main>
  </BaseLayout>
)}
<style>
  .blog-body :global(p) {
    margin: 0 0 1.25rem;
    line-height: 1.7;
    font-size: 15px;
  }
  .blog-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .blog-body :global(.pull-quote) {
    border-left: 1px solid var(--color-line);
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
    font-size: 1.125rem;
    color: var(--color-ink);
  }
  .blog-body :global(a) {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .blog-body :global(a:hover) {
    opacity: 0.6;
  }
  .blog-body :global(strong) {
    font-weight: 600;
  }
</style>
