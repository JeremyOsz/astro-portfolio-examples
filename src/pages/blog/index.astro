---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { routeImageSets } from "../../lib/imagePool";

function formatBlogDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const allPosts = await getCollection("blog", (e) => !e.data.draft);
const sorted = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featured = sorted[0];
const rest = sorted.slice(1);
const featuredImage = routeImageSets.blog.featured;
---

<BaseLayout
  title="Blog — Portfolio Studies"
  description="Notes, process, and essays."
  currentPath="/blog"
>
  <main>
    <p class="section-kicker">05 / Journal</p>
    <h1 class="display-title mt-3 max-w-[10ch] relative">
      Notes & essays
      <span class="ghost-index top-1 right-auto" style="left:56%" aria-hidden="true">05</span>
    </h1>

    {featured && (
      <a href={`/blog/${featured.slug}`} class="group block mt-10 border-y border-line py-8 md:mt-12 md:py-10">
        <article class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-12">
          <div class="md:col-span-5 order-2 md:order-1 flex flex-col justify-end md:pr-8">
            <p class="section-kicker">{featured.data.category}</p>
            <h2 class="mt-1 text-xl font-normal leading-tight text-ink md:text-2xl group-hover:opacity-60 transition-opacity">
              {featured.data.title}
            </h2>
            <p class="mt-2 text-[12px] text-muted">{formatBlogDate(featured.data.date)}</p>
            <p class="mt-3 text-[14px] leading-relaxed text-muted">{featured.data.excerpt}</p>
          </div>
          <div class="md:col-span-7 order-1 md:order-2 md:-mt-3">
            {featuredImage && (
              <figure class="m-0">
                <div class="aspect-[16/10]">
                  <img
                    src={featuredImage.src}
                    alt={featuredImage.alt}
                    loading="eager"
                    class="h-full w-full object-cover"
                  />
                </div>
              </figure>
            )}
          </div>
        </article>
      </a>
    )}

    {rest.length > 0 && (
      <section class="mt-10 md:mt-12 border-t border-line">
        <ul class="m-0 list-none p-0">
          {rest.map((post, i) => (
            <li>
              <a href={`/blog/${post.slug}`} class="group block border-b border-line py-5 md:py-6 transition-opacity hover:opacity-60">
                <article class="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-8">
                  <span class="text-[11px] text-muted tabular-nums md:w-[28px] shrink-0">{String(i + 1).padStart(2, "0")}</span>
                  <span class="text-[12px] text-muted md:w-[120px] shrink-0">
                    {formatBlogDate(post.data.date)}
                  </span>
                  <span class="text-[15px] font-medium text-ink flex-1">
                    {post.data.title}
                  </span>
                  <span class="text-[11px] uppercase tracking-[0.12em] text-muted md:hidden">
                    {post.data.category}
                  </span>
                  <span class="text-[11px] text-muted shrink-0 hidden md:block">
                    [{post.data.category}]
                  </span>
                </article>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
