---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { routeImageSets } from "../../lib/imagePool";

function formatBlogDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const allPosts = await getCollection("blog", (e) => !e.data.draft);
const sorted = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featured = sorted[0];
const rest = sorted.slice(1);
const thumbnails = routeImageSets.blog.thumbnails;
const featuredImage = routeImageSets.blog.featured;
---

<BaseLayout
  title="Blog — Portfolio Studies"
  description="Notes, process, and essays."
  currentPath="/blog"
>
  <main>
    <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-accent">Blog</p>
    <h1 class="mt-2 font-serif text-4xl font-medium leading-[0.95] tracking-tight text-ink md:text-5xl lg:text-6xl">
      Notes & essays
    </h1>

    {featured && (
      <a href={`/blog/${featured.slug}`} class="group block mt-10 md:mt-14">
        <article class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-8">
          <div class="md:col-span-5 order-2 md:order-1 flex flex-col justify-end">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-muted">{featured.data.category}</p>
            <h2 class="mt-2 font-serif text-2xl font-medium leading-tight text-ink md:text-3xl group-hover:underline">
              {featured.data.title}
            </h2>
            <p class="mt-2 text-sm text-muted">{formatBlogDate(featured.data.date)}</p>
            <p class="mt-4 text-sm leading-relaxed text-ink">{featured.data.excerpt}</p>
          </div>
          <div class="md:col-span-7 order-1 md:order-2 relative">
            {featuredImage && (
              <figure class="m-0 overflow-hidden border-2 border-ink bg-paper-strong">
                <div class="aspect-[16/10]">
                  <img
                    src={featuredImage.src}
                    alt={featuredImage.alt}
                    loading="eager"
                    class="h-full w-full object-cover"
                  />
                </div>
              </figure>
            )}
            <div class="absolute -bottom-2 -right-2 z-10 h-12 w-12 bg-accent md:h-16 md:w-16" aria-hidden="true" />
          </div>
        </article>
      </a>
    )}

    <section class="mt-14 md:mt-20 border-t-2 border-ink pt-10 md:pt-14">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted">More</p>
      <ul class="mt-6 list-none m-0 p-0 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((post, i) => {
          const thumb = thumbnails[(i + 1) % thumbnails.length];
          return (
            <li>
              <a href={`/blog/${post.slug}`} class="group block">
                <article class="border-2 border-ink bg-paper overflow-hidden transition-colors hover:bg-paper-strong">
                  {thumb && (
                    <div class="aspect-[4/3] overflow-hidden">
                      <img
                        src={thumb.src}
                        alt=""
                        loading="lazy"
                        class="h-full w-full object-cover"
                      />
                    </div>
                  )}
                  <div class="p-4 md:p-5">
                    <p class="text-[10px] font-semibold uppercase tracking-widest text-accent">{post.data.category}</p>
                    <h3 class="mt-2 font-serif text-lg font-medium leading-tight text-ink group-hover:underline">{post.data.title}</h3>
                    <p class="mt-1 font-mono text-xs text-muted">{formatBlogDate(post.data.date)}</p>
                    <p class="mt-3 text-sm leading-relaxed text-muted line-clamp-3">{post.data.excerpt}</p>
                  </div>
                </article>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
</BaseLayout>
