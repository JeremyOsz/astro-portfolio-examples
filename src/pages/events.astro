---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

function formatEventDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric"
  });
}

const eventEntries = await getCollection("events");
const events = eventEntries.sort(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime()
);
---

<BaseLayout
  title="Events — Portfolio Studies"
  description="Upcoming events and appearances."
  currentPath="/events"
>
  <main>
    <p class="section-kicker">06 / Public programme</p>
    <h1 class="display-title mt-3 max-w-[9ch] relative">
      Upcoming events
      <span class="ghost-index top-0 right-auto" style="left:62%" aria-hidden="true">06</span>
    </h1>
    <p class="mt-3 max-w-[48ch] text-[14px] leading-relaxed text-muted">
      Exhibitions, readings, workshops, and talks.
    </p>

    <section class="mt-10 md:mt-14 border-t border-line">
      <ul class="m-0 list-none p-0">
        {events.map((event) => (
          <li class="border-b border-line py-5 md:py-6">
            <div class="grid grid-cols-1 gap-1 md:grid-cols-[150px_1fr] md:gap-8">
              <div class="md:w-[140px] shrink-0">
                <p class="text-[12px] text-muted uppercase tracking-[0.08em]">{formatEventDate(event.data.date)}</p>
                {event.data.time && <p class="text-[12px] text-muted">{event.data.time}</p>}
              </div>
              <div class="flex-1">
                <h2 class="text-[15px] font-medium text-ink">
                  {event.data.url ? (
                    <a href={event.data.url} class="hover:opacity-60 transition-opacity">{event.data.title}</a>
                  ) : (
                    event.data.title
                  )}
                </h2>
                <p class="mt-0.5 text-[13px] text-muted">
                  {event.data.venue}, {event.data.location}
                </p>
                {event.data.note && (
                  <p class="mt-1 text-[11px] uppercase tracking-[0.1em] text-muted">
                    {event.data.note}
                  </p>
                )}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
