---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPersona } from "../lib/content-cms";
import { personas } from "../lib/content";
import { routeImageSets } from "../lib/imagePool";
import { siteRouteId } from "../lib/mainNav";

const routeId = siteRouteId("/visual-artist");
const persona = (await getPersona("visual-artist")) ?? {
  ...personas["visual-artist"],
  notes: personas["visual-artist"].notes
};
const lead = routeImageSets.visualArtist.lead;
const gallery = routeImageSets.visualArtist.gallery;
---

<BaseLayout
  title="Visual Artist Portfolio Example"
  description="Editorial visual artist portfolio example in Astro."
  currentPath="/visual-artist"
>
  <main>
    <section class="grid grid-cols-1 gap-8 border-b border-line pb-10 md:grid-cols-12 md:gap-12 md:pb-14">
      <div class="relative min-h-[1px] md:col-span-6 flex flex-col justify-end">
        <span class="ghost-index" aria-hidden="true">{routeId}</span>
        <p class="section-kicker">{routeId} / Portfolio</p>
        <h1 class="display-title mt-3 max-w-[12ch]">
          {persona.title}
        </h1>
        <p class="lede mt-5 max-w-[46ch]">
          {persona.statement}
        </p>
        <dl class="mt-8 grid grid-cols-2 gap-x-8 gap-y-4 md:max-w-[28ch]">
          <div>
            <dt class="section-kicker">Location</dt>
            <dd class="mt-0.5 text-[14px]">{persona.location}</dd>
          </div>
          <div>
            <dt class="section-kicker">Focus</dt>
            <dd class="mt-0.5 text-[14px]">{persona.focus}</dd>
          </div>
          <div>
            <dt class="section-kicker">Format</dt>
            <dd class="mt-0.5 text-[14px]">{persona.format}</dd>
          </div>
        </dl>
      </div>
      <div class="md:col-span-6 md:pt-5 md:self-start">
        {lead && (
          <figure class="m-0">
            <div class="aspect-[4/3] md:aspect-[16/10]">
              <img
                src={lead.src}
                alt={lead.alt}
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-2 text-[11px] uppercase tracking-[0.08em] text-muted">
              {lead.title} — {lead.artist}, {lead.displayDate}
            </figcaption>
          </figure>
        )}
      </div>
    </section>

    <section class="mt-10 md:mt-14">
      <p class="section-kicker mb-6">Selected works</p>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
        {gallery.map((image, i) => (
          <figure
            class={`m-0 ${
              i === 0 ? "md:col-span-4 md:row-span-2" : i === 4 ? "md:col-span-3" : "md:col-span-2"
            }`}
          >
            <div class={i === 0 ? "aspect-[4/3] md:aspect-auto md:h-full min-h-[220px]" : "aspect-square"}>
              <img
                src={image.src}
                alt={image.alt}
                loading={i < 4 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-1.5 text-[11px] text-muted">
              {String(i + 1).padStart(2, "0")} — {image.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="mt-14 md:mt-18 grid grid-cols-1 gap-6 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="section-kicker">Studio notes</p>
      </div>
      <ul class="md:col-span-9 list-none m-0 p-0 space-y-3 text-[14px] leading-relaxed text-ink">
        {persona.notes.map((note) => (
          <li class="border-l border-line pl-4">{note}</li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
