---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPersona } from "../lib/content-cms";
import { personas } from "../lib/content";
import { routeImageSets } from "../lib/imagePool";

const persona = (await getPersona("visual-artist")) ?? {
  ...personas["visual-artist"],
  notes: personas["visual-artist"].notes
};
const lead = routeImageSets.visualArtist.lead;
const gallery = routeImageSets.visualArtist.gallery;
---

<BaseLayout
  title="Visual Artist Portfolio Example"
  description="Editorial visual artist portfolio example in Astro."
  currentPath="/visual-artist"
>
  <main>
    <!-- Hero: image-first, text overlay, angular block -->
    <section class="relative grid grid-cols-1 gap-0 md:grid-cols-12 md:gap-6 lg:gap-8">
      <div class="order-2 md:order-1 md:col-span-5 flex flex-col justify-end pb-6 md:pb-0">
        <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-muted">{persona.label}</p>
        <h1 class="mt-1 font-serif text-4xl font-medium leading-[0.95] tracking-tight text-ink md:text-5xl lg:text-6xl">
          {persona.title}
        </h1>
        <p class="mt-4 max-w-[42ch] text-sm leading-relaxed text-muted md:text-base">
          {persona.statement}
        </p>
      </div>
      <div class="order-1 md:order-2 md:col-span-7 relative">
        {lead && (
          <figure class="m-0 overflow-hidden border-2 border-ink bg-paper-strong">
            <div class="aspect-[4/3] md:aspect-[16/10]">
              <img
                src={lead.src}
                alt={lead.alt}
                loading="eager"
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="border-t border-line bg-paper px-4 py-3 text-[11px] uppercase tracking-wider text-muted">
              {lead.title} — {lead.artist}, {lead.displayDate}
            </figcaption>
          </figure>
        )}
        <!-- Angular accent block -->
        <div class="absolute -bottom-3 -right-3 z-10 h-16 w-16 bg-accent md:h-24 md:w-24" aria-hidden="true" />
      </div>
    </section>

    <!-- Meta strip with accent -->
    <section class="mt-12 md:mt-16 flex flex-wrap items-baseline gap-x-8 gap-y-2 border-y border-line py-4">
      <div>
        <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Location</dt>
        <dd class="mt-0.5 text-sm font-medium">{persona.location}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Focus</dt>
        <dd class="mt-0.5 text-sm font-medium">{persona.focus}</dd>
      </div>
      <div>
        <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Format</dt>
        <dd class="mt-0.5 text-sm font-medium">{persona.format}</dd>
      </div>
    </section>

    <!-- Work grid: asymmetric, angular, image-first -->
    <section class="mt-14 md:mt-20">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-muted">Work</p>
      <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:gap-5">
        {gallery.map((image, i) => (
          <figure
            class={`m-0 overflow-hidden border-2 border-ink bg-paper-strong ${
              i === 0 ? "md:col-span-2 md:row-span-2" : ""
            }`}
          >
            <div class={i === 0 ? "aspect-[4/3] md:aspect-auto md:h-full min-h-[200px]" : "aspect-square"}>
              <img
                src={image.src}
                alt={image.alt}
                loading={i < 4 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="border-t border-line px-3 py-2 text-[10px] font-medium uppercase tracking-wider text-muted">
              {image.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- Studio notes: bold label + list -->
    <section class="mt-14 md:mt-20 grid grid-cols-1 gap-6 md:grid-cols-12">
      <div class="md:col-span-4">
        <h2 class="text-lg font-semibold uppercase tracking-widest text-accent">Studio notes</h2>
      </div>
      <ul class="md:col-span-8 list-none m-0 p-0 space-y-2 text-sm leading-relaxed">
        {persona.notes.map((note) => (
          <li class="border-l-2 border-accent pl-4">{note}</li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>
