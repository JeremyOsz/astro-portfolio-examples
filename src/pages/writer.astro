---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPersona } from "../lib/content-cms";
import { personas, writerExcerpts } from "../lib/content";
import { routeImageSets } from "../lib/imagePool";
import { siteRouteId } from "../lib/mainNav";

const routeId = siteRouteId("/writer");
const cmsPersona = await getPersona("writer");
const persona = cmsPersona ?? {
  ...personas.writer,
  notes: personas.writer.notes,
  excerpts: undefined
};
const writerExcerptsToShow = persona.excerpts ?? writerExcerpts;
const covers = routeImageSets.writer.covers;
const details = routeImageSets.writer.details;
---

<BaseLayout
  title="Writer Portfolio Example"
  description="Text-first writer portfolio example in Astro."
  currentPath="/writer"
>
  <main>
    <section class="grid grid-cols-1 gap-8 border-b border-line pb-10 md:grid-cols-12 md:gap-12 md:pb-14">
      <div class="relative min-h-[1px] md:col-span-7">
        <span class="ghost-index" aria-hidden="true">{routeId}</span>
        <p class="section-kicker">{routeId} / Portfolio</p>
        <h1 class="display-title mt-3 max-w-[12ch]">
          {persona.title}
        </h1>
        <p class="lede mt-5 max-w-[48ch]">
          {persona.statement}
        </p>
      </div>
      <div class="md:col-span-5 grid grid-cols-3 gap-2 md:pt-6">
        {covers.map((cover) => (
          <figure class="m-0">
            <img src={cover.src} alt={cover.alt} loading="lazy" class="aspect-[3/4] w-full object-cover" />
          </figure>
        ))}
      </div>
    </section>

    <section class="mt-10 md:mt-14">
      <p class="section-kicker">Selected excerpts</p>
      <div class="mt-8 space-y-12 md:space-y-16">
        {writerExcerptsToShow.map((excerpt, i) => (
          <article class="grid grid-cols-1 gap-4 border-l border-line pl-4 md:grid-cols-12 md:gap-10 md:pl-8">
            <div class="md:col-span-4">
              <p class="text-[11px] tabular-nums text-muted mb-1">{String(i + 1).padStart(2, "0")}</p>
              <p class="text-[11px] uppercase tracking-[0.12em] text-muted">{excerpt.publication}</p>
              <h2 class="mt-1 text-lg font-normal text-ink">{excerpt.title}</h2>
            </div>
            <blockquote class="md:col-span-8">
              <p class="text-lg leading-snug text-ink md:text-xl">
                "{excerpt.text}"
              </p>
            </blockquote>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-16 md:mt-24 grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-4 space-y-5">
        <dl class="grid gap-4">
          <div>
            <dt class="section-kicker">Location</dt>
            <dd class="mt-0.5 text-[14px]">{persona.location}</dd>
          </div>
          <div>
            <dt class="section-kicker">Focus</dt>
            <dd class="mt-0.5 text-[14px]">{persona.focus}</dd>
          </div>
          <div>
            <dt class="section-kicker">Format</dt>
            <dd class="mt-0.5 text-[14px]">{persona.format}</dd>
          </div>
        </dl>
        <ul class="list-none m-0 p-0 space-y-3 text-[14px] text-muted leading-relaxed">
          {persona.notes.map((note) => (
            <li class="pl-4 border-l border-line">{note}</li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-8 grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-4">
        {details.map((image, i) => (
          <figure class={`m-0 ${i === 0 ? "md:col-span-4" : "md:col-span-2"}`}>
            <img src={image.src} alt={image.alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="mt-1.5 text-[11px] text-muted">
              {image.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
