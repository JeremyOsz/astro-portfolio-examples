---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPersona } from "../lib/content-cms";
import { personas, writerExcerpts } from "../lib/content";
import { routeImageSets } from "../lib/imagePool";

const cmsPersona = await getPersona("writer");
const persona = cmsPersona ?? {
  ...personas.writer,
  notes: personas.writer.notes,
  excerpts: undefined
};
const writerExcerptsToShow = persona.excerpts ?? writerExcerpts;
const covers = routeImageSets.writer.covers;
const details = routeImageSets.writer.details;
---

<BaseLayout
  title="Writer Portfolio Example"
  description="Text-first writer portfolio example in Astro."
  currentPath="/writer"
>
  <main>
    <!-- Hero: name + statement + cover stack (editorial spread) -->
    <section class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10 lg:gap-12">
      <div class="md:col-span-7">
        <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-accent">{persona.label}</p>
        <h1 class="mt-2 font-serif text-4xl font-medium leading-[0.95] tracking-tight text-ink md:text-5xl lg:text-6xl">
          {persona.title}
        </h1>
        <p class="mt-6 max-w-[48ch] text-base leading-relaxed text-muted">
          {persona.statement}
        </p>
      </div>
      <div class="md:col-span-5 grid grid-cols-3 gap-2">
        {covers.map((cover) => (
          <figure class="m-0 overflow-hidden border-2 border-ink bg-paper-strong">
            <img src={cover.src} alt={cover.alt} loading="lazy" class="aspect-[3/4] w-full object-cover" />
          </figure>
        ))}
      </div>
    </section>

    <!-- Excerpts: bold pull quotes, red accent labels -->
    <section class="mt-14 md:mt-20 border-t-2 border-ink pt-10 md:pt-14">
      <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-accent">Selected excerpts</p>
      <div class="mt-8 space-y-12 md:space-y-16">
        {writerExcerptsToShow.map((excerpt) => (
          <article class="grid grid-cols-1 gap-6 md:grid-cols-12 md:gap-10">
            <div class="md:col-span-5">
              <p class="font-mono text-xs uppercase tracking-wider text-muted">{excerpt.publication}</p>
              <h2 class="mt-2 font-serif text-xl font-medium text-ink md:text-2xl">{excerpt.title}</h2>
            </div>
            <blockquote class="md:col-span-7 md:border-l-2 md:border-accent md:pl-10">
              <p class="text-lg font-medium leading-snug text-ink md:text-xl lg:text-2xl">
                "{excerpt.text}"
              </p>
            </blockquote>
          </article>
        ))}
      </div>
    </section>

    <!-- Meta + detail images: angular grid -->
    <section class="mt-14 md:mt-20 grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-4 space-y-6">
        <dl class="grid gap-4">
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Location</dt>
            <dd class="mt-0.5 text-sm font-medium">{persona.location}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Focus</dt>
            <dd class="mt-0.5 text-sm font-medium">{persona.focus}</dd>
          </div>
          <div>
            <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Format</dt>
            <dd class="mt-0.5 text-sm font-medium">{persona.format}</dd>
          </div>
        </dl>
        <ul class="list-none m-0 p-0 space-y-2 text-sm text-muted">
          {persona.notes.map((note) => (
            <li class="pl-4 border-l-2 border-line">{note}</li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-8 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4">
        {details.map((image) => (
          <figure class="m-0 overflow-hidden border-2 border-ink bg-paper-strong">
            <img src={image.src} alt={image.alt} loading="lazy" class="aspect-[4/3] w-full object-cover" />
            <figcaption class="border-t border-line px-3 py-2 text-[10px] font-medium uppercase tracking-wider text-muted">
              {image.title}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
