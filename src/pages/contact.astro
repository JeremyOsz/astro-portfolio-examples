---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Portfolio Studies"
  description="Get in touch."
  currentPath="/contact"
>
  <main>
    <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-accent">Contact</p>
    <h1 class="mt-2 font-serif text-4xl font-medium leading-[0.95] tracking-tight text-ink md:text-5xl lg:text-6xl">
      Get in touch
    </h1>
    <p class="mt-6 max-w-[48ch] text-base leading-relaxed text-muted">
      For commissions, collaborations, teaching, or press — use the details below.
    </p>

    <section class="mt-12 md:mt-16 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5 space-y-8">
        <div>
          <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Email</dt>
          <dd class="mt-1.5">
            <a href="mailto:hello@example.com" class="text-ink font-medium underline underline-offset-2 hover:text-accent">
              hello@example.com
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Based</dt>
          <dd class="mt-1.5 text-ink">Berlin / Lisbon / Melbourne</dd>
        </div>
        <div>
          <dt class="text-[10px] font-semibold uppercase tracking-widest text-muted">Elsewhere</dt>
          <dd class="mt-1.5 flex flex-wrap gap-4">
            <a href="#" class="text-ink font-medium underline underline-offset-2 hover:text-accent">Instagram</a>
            <a href="#" class="text-ink font-medium underline underline-offset-2 hover:text-accent">Twitter</a>
          </dd>
        </div>
      </div>
      <div class="md:col-span-7 border-2 border-ink bg-paper-strong p-6 md:p-10">
        <p class="text-[10px] font-semibold uppercase tracking-widest text-muted">Note</p>
        <p class="mt-3 text-sm leading-relaxed text-ink">
          This is a placeholder contact block. Replace with your own email, location, and links. The layout stays the same: labels in uppercase, one accent colour for links on hover.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
