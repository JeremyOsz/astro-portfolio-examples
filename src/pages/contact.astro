---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact — Portfolio Studies"
  description="Get in touch."
  currentPath="/contact"
>
  <main>
    <p class="section-kicker">07 / Contact</p>
    <h1 class="display-title mt-3 max-w-[8ch] relative">
      Contact
      <span class="ghost-index top-0 right-auto" style="left:74%" aria-hidden="true">07</span>
    </h1>
    <p class="mt-3 max-w-[48ch] text-[14px] leading-relaxed text-muted">
      For commissions, collaborations, teaching, or press.
    </p>

    <section class="mt-10 md:mt-14 border-t border-line pt-8 md:pt-10">
      <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-12">
        <div class="md:col-span-5 space-y-6 md:pr-4">
          <div>
            <p class="section-kicker">Email</p>
            <p class="mt-1">
              <a href="mailto:hello@example.com" class="text-[15px] text-ink hover:opacity-60 transition-opacity">
                hello@example.com
              </a>
            </p>
          </div>
          <div>
            <p class="section-kicker">Based</p>
            <p class="mt-1 text-[15px]">Berlin / Lisbon / Melbourne</p>
          </div>
          <div>
            <p class="section-kicker">Elsewhere</p>
            <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-[15px]">
              <a href="https://instagram.com" class="text-ink hover:opacity-60 transition-opacity">Instagram</a>
              <a href="https://x.com" class="text-ink hover:opacity-60 transition-opacity">X / Twitter</a>
            </p>
          </div>
        </div>
        <div class="md:col-span-7 border-l border-line pl-6 md:pl-10">
          <p class="section-kicker">Note</p>
          <p class="mt-3 text-[14px] leading-relaxed text-muted">
            This is a placeholder contact block. Replace with your own email, location, and links.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
