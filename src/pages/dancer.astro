---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPersona } from "../lib/content-cms";
import { personas } from "../lib/content";
import { routeImageSets } from "../lib/imagePool";
import { siteRouteId } from "../lib/mainNav";

const routeId = siteRouteId("/dancer");
const persona = (await getPersona("dancer")) ?? {
  ...personas.dancer,
  notes: personas.dancer.notes
};
const strips = routeImageSets.dancer.strips;
const portraits = routeImageSets.dancer.portraits;
---

<BaseLayout
  title="Dancer Portfolio Example"
  description="Movement practitioner portfolio example in Astro."
  currentPath="/dancer"
>
  <main>
    <section class="mb-10 border-b border-line pb-10 md:mb-14 md:pb-14">
      <div class="relative max-w-[min(100%,52rem)]">
        <span class="ghost-index" aria-hidden="true">{routeId}</span>
        <p class="section-kicker">{routeId} / Portfolio</p>
      <h1 class="display-title mt-3 max-w-[11ch]">
        {persona.title}
      </h1>
      <p class="lede mt-5 max-w-[55ch]">
        {persona.statement}
      </p>
      </div>
    </section>

    <section aria-label="Movement sequence">
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <p class="section-kicker">Movement sequence</p>
        <p class="text-[11px] uppercase tracking-[0.12em] text-muted">{strips.length} frames</p>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-12 md:gap-3">
        {strips.map((image, index) => (
          <figure class={`m-0 ${index === 0 || index === 5 ? "md:col-span-3" : "md:col-span-2"}`}>
            <div class="aspect-[3/4]">
              <img
                src={image.src}
                alt={image.alt}
                loading={index < 2 ? "eager" : "lazy"}
                class="h-full w-full object-cover"
              />
            </div>
            <figcaption class="mt-1 text-[11px] uppercase tracking-[0.08em] text-muted">
              frame {String(index + 1).padStart(2, "0")}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="mt-16 md:mt-24 grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5 space-y-8">
        <dl class="grid grid-cols-2 gap-x-8 gap-y-5">
          <div>
            <dt class="section-kicker">Location</dt>
            <dd class="mt-0.5 text-[14px]">{persona.location}</dd>
          </div>
          <div>
            <dt class="section-kicker">Focus</dt>
            <dd class="mt-0.5 text-[14px]">{persona.focus}</dd>
          </div>
          <div>
            <dt class="section-kicker">Format</dt>
            <dd class="mt-0.5 text-[14px]">{persona.format}</dd>
          </div>
        </dl>
        <ul class="list-none m-0 p-0 space-y-3 text-[14px] leading-relaxed text-ink">
          {persona.notes.map((note) => (
            <li class="border-l border-line pl-4">{note}</li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-7 grid grid-cols-2 gap-3 md:grid-cols-6">
        {portraits.map((image) => (
          <figure class="m-0 md:col-span-3">
            <img src={image.src} alt={image.alt} loading="lazy" class="aspect-[3/4] w-full object-cover" />
          </figure>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
